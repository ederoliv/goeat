{
  "openapi": "3.1.1",
  "info": {
    "title": "Goeat API | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5143/"
    }
  ],
  "paths": {
    "/api/v1/address": {
      "get": {
        "tags": [
          "Address"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/restaurants/{restaurantId}/menu": {
      "get": {
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "name": "restaurantId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/restaurants/{restaurantId}/menu/{itemId}": {
      "get": {
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "name": "restaurantId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
