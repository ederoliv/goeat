  "components": {
    "schemas": {
      "CreateOrderItemRequest": {
        "required": [
          "productId"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "quantity": {
            "maximum": 99,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateOrderRequest": {
        "required": [
          "restaurantId",
          "fulfillmentType",
          "paymentMethod",
          "items"
        ],
        "type": "object",
        "properties": {
          "restaurantId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "fulfillmentType": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/FulfillmentType"
              }
            ]
          },
          "paymentMethod": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PaymentMethod"
              }
            ]
          },
          "customerName": {
            "maxLength": 150,
            "minLength": 2,
            "type": [
              "null",
              "string"
            ]
          },
          "customerPhone": {
            "maxLength": 30,
            "minLength": 8,
            "type": [
              "null",
              "string"
            ]
          },
          "deliveryAddress": {
            "maxLength": 300,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "items": {
            "maxItems": 50,
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemRequest"
            }
          }
        }
      },
      "CustomerAddressRequest": {
        "required": [
          "label",
          "street",
          "number",
          "neighborhood",
          "city",
          "state",
          "zipCode"
        ],
        "type": "object",
        "properties": {
          "label": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "street": {
            "maxLength": 150,
            "minLength": 2,
            "type": "string"
          },
          "number": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "complement": {
            "maxLength": 100,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "neighborhood": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "city": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "state": {
            "maxLength": 2,
            "minLength": 2,
            "type": "string"
          },
          "zipCode": {
            "maxLength": 10,
            "minLength": 8,
            "type": "string"
          },
          "isPrimary": {
            "type": "boolean"
          }
        }
